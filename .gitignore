# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Virtualenvs
venv/
.venv/
env/
ENV/
venv.bak/

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Logs and databases
*.log
*.sqlite3

# Compiled extensions
*.so
*.dylib

# ROS / colcon
install/
log/
.rosinstall

# Misc
*.pyc
*.pyo
*.pyd

# Markdown docs are TRACKED (design notes, guides, per-package docs).
# The previous blanket `*.md` ignore silently dropped everything except
# README.md -- including files that other docs link to, e.g.
# setup/PTP_SYNC_CONTEXT.md and setup/guia_ptp_sincronizacion.md referenced
# from setup/README.md. If you need to ignore a generated .md, ignore it by
# explicit path instead of re-adding a blanket rule here.

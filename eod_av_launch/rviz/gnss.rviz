Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Value: true
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Marker Scale: 2
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/Path
      Name: /gps_path
      Enabled: true
      Value: true
      Topic:
        Value: /gps_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Buffer Length: 1
      Color: 25; 255; 0
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
  Global Options:
    Background Color: 48; 48; 48
    # base_link y no map: 'map' solo existe DESPUES del primer fix valido
    # (lo publica fix_to_path). Con Fixed Frame=map, sin lock RViz no dibuja
    # absolutamente nada y el unico sintoma es "Fixed Frame [map] does not
    # exist", que se lee como si el software estuviera roto. Con base_link la
    # ventana funciona siempre: se ve el arbol TF del vehiculo, y /gps_path
    # aparece solo cuando hay posicion. Para seguir la trayectoria en un mapa
    # fijo, cambiar a 'map' desde el desplegable una vez que haya fix.
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 3.1
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 60
  Y: 60

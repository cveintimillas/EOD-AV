Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Value: true
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Marker Scale: 2
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR /lidar_points
      Enabled: true
      Value: true
      Topic:
        Value: /lidar_points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Filter size: 10
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Radar /radar_pointcloud_1
      Enabled: true
      Value: true
      Topic:
        Value: /radar_pointcloud_1
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Filter size: 10
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: velocity
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 1
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.3
      Style: Spheres
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Radar clusters
      Enabled: true
      Value: true
      Namespaces: {}
      Topic:
        Value: /radar/cluster_markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: GPS /gps_path
      Enabled: true
      Value: true
      Topic:
        Value: /gps_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Buffer Length: 1
      Color: 25; 255; 0
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
    - Class: rviz_default_plugins/Image
      Name: cam_enp6s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp6s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: cam_enp7s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp7s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: cam_enp8s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp8s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
  Global Options:
    Background Color: 48; 48; 48
    # map (mundo), NO base_link: map -> base_link la publica fix_to_path con el
    # GNSS, asi que con Fixed Frame=map el conjunto de sensores se DESPLAZA por
    # la escena y /gps_path va quedando dibujado detras (trayectoria). Con
    # base_link el vehiculo quedaria clavado en el centro y seria el mundo el
    # que se mueve, que no es lo que se quiere al trazar el recorrido.
    # Sin GNSS (enable_gnss:=false o antes del primer fix) el frame map no
    # existe: cambiar Fixed Frame a base_link en el desplegable de RViz.
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.1
      # Target Frame base_link (no <Fixed Frame>): la camara SIGUE al vehiculo
      # mientras el mundo y /gps_path quedan fijos en map. Asi no hay que
      # perseguir la escena con el mouse a medida que avanza el recorrido.
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  cam_enp6s0:
    collapsed: false
  cam_enp7s0:
    collapsed: false
  cam_enp8s0:
    collapsed: false
  Height: 1000
  Width: 1800
  X: 40
  Y: 40

Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Value: true
  Displays:
    - Class: rviz_default_plugins/Image
      Name: cam_enp6s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp6s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: cam_enp7s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp7s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: cam_enp8s0
      Enabled: true
      Value: true
      Topic:
        Value: /arena_camera_node/enp8s0/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Marker Scale: 1
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 3.1
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  cam_enp6s0:
    collapsed: false
  cam_enp7s0:
    collapsed: false
  cam_enp8s0:
    collapsed: false
  Height: 900
  Width: 1600
  X: 60
  Y: 60
